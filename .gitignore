node_modules/

# Lock files — each example is standalone and installs fresh; don't commit their lockfiles.
# Only the docs site's own pnpm-lock.yaml (this folder's root) is committed.
package-lock.json
yarn.lock
pnpm-lock.yaml
!/pnpm-lock.yaml

dist/
.next/
out-tsc/
.svelte-kit/
.angular/
*.log
.env
.env.local
.env.*.local
.DS_Store
*.tsbuildinfo

# Native SDK build artifacts (for upcoming Android / iOS / Flutter SDKs maintained here)
.gradle/
build/
*.iml
.dart_tool/
Pods/
DerivedData/
*.xcuserstate

# Private QA notes, personal agent settings, upgrade backups and task state — never committed.
.qa/
.claude/settings.local.json
.friday-backup/
scripts/agent/state/
# VitePress build output and cache: regenerated by every docs build or dev run
docs/.vitepress/.temp/
docs/.vitepress/cache/
